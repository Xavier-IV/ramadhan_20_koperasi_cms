#!/usr/bin/env bash
set -e

# === MASTER BRANCH PROTECTION ===
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "master" ] || [ "$branch" = "main" ]; then
  echo ""
  echo "ERROR: Direct commits to '$branch' are not allowed."
  echo ""
  echo "  You are on the '$branch' branch. All changes must be made on a feature branch"
  echo "  and merged via pull request."
  echo ""
  echo "  To fix this:"
  echo "    git checkout -b feature/your-change-name"
  echo "    git commit  # then commit on the new branch"
  echo ""
  exit 1
fi

echo "== Pre-commit: Running RuboCop =="
bin/rubocop --no-color

echo "== Pre-commit: OK =="
