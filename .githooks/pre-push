#!/usr/bin/env bash
set -e

# === DETECT REF-DELETE (git push --delete) ===
# Read stdin to check for delete operations. If all local SHAs are zeros,
# this is a branch/tag deletion — skip all checks.
all_deletes=true
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    all_deletes=false
  fi
done

if [ "$all_deletes" = true ]; then
  exit 0
fi

# === MASTER BRANCH PROTECTION ===
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "master" ] || [ "$branch" = "main" ]; then
  echo ""
  echo "ERROR: Direct pushes to '$branch' are not allowed."
  echo ""
  echo "  You are on the '$branch' branch. All changes must be pushed from a feature"
  echo "  branch and merged via pull request on GitHub."
  echo ""
  echo "  To fix this:"
  echo "    git checkout -b feature/your-change-name"
  echo "    git push -u origin feature/your-change-name"
  echo ""
  exit 1
fi

echo "== Pre-push: Running RuboCop =="
bin/rubocop --no-color

echo "== Pre-push: Running Brakeman =="
bin/brakeman --no-pager --quiet

echo "== Pre-push: Running tests =="
bin/rails test

echo "== Pre-push: All checks passed =="
