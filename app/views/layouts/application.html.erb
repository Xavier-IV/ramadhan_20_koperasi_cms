<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for(:title) || Rails.application.class.module_parent_name.titleize %></title>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 antialiased">
    <!-- Navbar -->
    <nav class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <%= link_to root_path, class: "text-lg font-bold text-gray-900" do %>
              <%= Rails.application.class.module_parent_name.titleize %>
            <% end %>
          </div>
          <div class="flex items-center gap-4">
            <% if authenticated? %>
              <span class="text-sm text-gray-600"><%= current_user&.email_address %></span>
              <%= link_to "Admin", admin_root_path, class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
              <%= button_to "Logout", session_path, method: :delete,
                class: "text-sm text-gray-500 hover:text-gray-700" %>
            <% else %>
              <%= link_to "Sign In", new_session_path, class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="p-4 bg-green-50 text-green-700 rounded-md text-sm"><%= notice %></div>
      </div>
    <% end %>
    <% if alert %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="p-4 bg-red-50 text-red-700 rounded-md text-sm"><%= alert %></div>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
