<%= form_with model: [:admin, announcement], class: ts(:form, :group) do |f| %>
  <% if announcement.errors.any? %>
    <div class="<%= ts(:alert, :wrapper) %> <%= ts(:alert, :error) %>">
      <div>
        <p class="<%= ts(:alert, :title) %>"><%= pluralize(announcement.errors.count, "error") %> prevented saving:</p>
        <ul class="<%= ts(:alert, :message) %> list-disc pl-4 mt-1">
          <% announcement.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="<%= ts(:form, :field) %>">
    <%= f.label :title, class: ts(:form, :label) %>
    <%= f.text_field :title, class: ts(:input, :base), placeholder: "Announcement title" %>
  </div>

  <div class="<%= ts(:form, :field) %>">
    <%= f.label :kind, class: ts(:form, :label) %>
    <%= f.select :kind, Announcement.kinds.keys.map { |k| [k.titleize, k] }, {}, class: ts(:select, :base) %>
  </div>

  <%= render "admin/components/rich_text_field", form: f, attribute: :body, label: "Content" %>

  <div class="flex items-center gap-6">
    <div class="<%= ts(:form, :field) %> flex-1">
      <%= f.label :starts_at, "Start date", class: ts(:form, :label) %>
      <%= f.datetime_local_field :starts_at, class: ts(:input, :base) %>
      <p class="<%= ts(:form, :hint) %>">Leave blank to start immediately</p>
    </div>
    <div class="<%= ts(:form, :field) %> flex-1">
      <%= f.label :ends_at, "End date", class: ts(:form, :label) %>
      <%= f.datetime_local_field :ends_at, class: ts(:input, :base) %>
      <p class="<%= ts(:form, :hint) %>">Leave blank to show indefinitely</p>
    </div>
  </div>

  <div class="<%= ts(:checkbox, :wrapper) %>">
    <%= f.check_box :active, class: ts(:checkbox, :input) %>
    <%= f.label :active, "Active", class: ts(:checkbox, :label) %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit announcement.persisted? ? "Update" : "Create", class: ts(:button, :primary) %>
    <%= link_to "Cancel", admin_announcements_path, class: ts(:button, :ghost) %>
  </div>
<% end %>
