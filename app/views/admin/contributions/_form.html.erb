<%= form_with model: [:admin, contribution], class: ts(:form, :group) do |f| %>
  <% if contribution.errors.any? %>
    <div class="<%= ts(:alert, :wrapper) %> <%= ts(:alert, :error) %>">
      <div>
        <p class="<%= ts(:alert, :title) %>"><%= pluralize(contribution.errors.count, "error") %> prevented saving:</p>
        <ul class="<%= ts(:alert, :message) %> list-disc pl-4 mt-1">
          <% contribution.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="<%= ts(:form, :field) %>">
    <%= f.label :member_id, "Member", class: ts(:form, :label) %>
    <%= f.collection_select :member_id, members, :id, :name, { prompt: "Select a member" }, class: ts(:select, :base) %>
  </div>

  <div class="flex items-center gap-6">
    <div class="<%= ts(:form, :field) %> flex-1">
      <%= f.label :amount, "Amount (RM)", class: ts(:form, :label) %>
      <%= f.number_field :amount, class: ts(:input, :base), step: "0.01", min: "0.01", placeholder: "50.00" %>
    </div>
    <div class="<%= ts(:form, :field) %> flex-1">
      <%= f.label :status, class: ts(:form, :label) %>
      <%= f.select :status, Contribution.statuses.keys.map { |s| [s.titleize, s] }, {}, class: ts(:select, :base) %>
    </div>
  </div>

  <div class="flex items-center gap-6">
    <div class="<%= ts(:form, :field) %> flex-1">
      <%= f.label :month, class: ts(:form, :label) %>
      <%= f.select :month, (1..12).map { |m| [Date::MONTHNAMES[m], m] }, {}, class: ts(:select, :base) %>
    </div>
    <div class="<%= ts(:form, :field) %> flex-1">
      <%= f.label :year, class: ts(:form, :label) %>
      <%= f.number_field :year, class: ts(:input, :base), min: 2001, max: Date.current.year + 1 %>
    </div>
  </div>

  <div class="<%= ts(:form, :field) %>">
    <%= f.label :paid_on, "Paid On", class: ts(:form, :label) %>
    <%= f.date_field :paid_on, class: ts(:input, :base) %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit contribution.persisted? ? "Update" : "Create", class: ts(:button, :primary) %>
    <%= link_to "Cancel", admin_contributions_path, class: ts(:button, :ghost) %>
  </div>
<% end %>
