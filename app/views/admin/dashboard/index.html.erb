<% content_for(:page_title, "Dashboard") %>

<%= render "admin/components/page_header", heading: "Dashboard" %>

<!-- Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">

  <!-- Card 1: Total Active Members -->
  <div class="<%= ts(:stat, :wrapper) %> rounded-lg border border-stone-200 bg-white p-6">
    <p class="text-3xl font-semibold text-stone-800 tabular-nums"><%= @total_active_members %></p>
    <p class="text-sm text-stone-500 mt-1">Active Members</p>
  </div>

  <!-- Card 2: Contributions This Month -->
  <div class="<%= ts(:stat, :wrapper) %> rounded-lg border border-stone-200 bg-white p-6">
    <p class="text-3xl font-semibold text-stone-800 tabular-nums">RM <%= number_with_delimiter(@total_contributions_this_month, delimiter: ",") %></p>
    <p class="text-sm text-stone-500 mt-1">Collected This Month (<%= Date::MONTHNAMES[Date.today.month] %> <%= Date.today.year %>)</p>
  </div>

  <!-- Card 3: Members in Arrears -->
  <% if @members_in_arrears.size > 0 %>
    <div class="rounded-lg border border-red-300 bg-red-50 p-6">
      <p class="text-3xl font-semibold text-red-900 tabular-nums"><%= @members_in_arrears.size %></p>
      <p class="text-sm text-red-700 mt-1">Members in Arrears (2+ missed)</p>
      <p class="text-xs text-red-600 mt-2"><%= @members_in_arrears.map { |m| "#{m.member_id} – #{m.name}" }.join(", ") %></p>
    </div>
  <% else %>
    <div class="rounded-lg border border-green-300 bg-green-50 p-6">
      <p class="text-3xl font-semibold text-green-900 tabular-nums">0</p>
      <p class="text-sm text-green-700 mt-1">Members in Arrears (2+ missed)</p>
      <p class="text-xs text-green-600 mt-2">All members up to date</p>
    </div>
  <% end %>

  <!-- Card 4: Loans Needing Attention -->
  <% if @loans_missed_this_month.size > 0 %>
    <div class="rounded-lg border border-amber-300 bg-amber-50 p-6">
      <p class="text-3xl font-semibold text-amber-900 tabular-nums"><%= @loans_missed_this_month.size %></p>
      <p class="text-sm text-amber-700 mt-1">Active Loans with No Repayment This Month</p>
      <p class="text-xs text-amber-600 mt-2"><%= @loans_missed_this_month.map { |l| l.member.name }.join(", ") %></p>
    </div>
  <% else %>
    <div class="rounded-lg border border-green-300 bg-green-50 p-6">
      <p class="text-3xl font-semibold text-green-900 tabular-nums">0</p>
      <p class="text-sm text-green-700 mt-1">Active Loans with No Repayment This Month</p>
      <p class="text-xs text-green-600 mt-2">All loans on track</p>
    </div>
  <% end %>

</div>

<!-- Quick Links -->
<div class="flex flex-wrap gap-3">
  <%= link_to "Members", admin_members_path, class: ts(:button, :secondary) %>
  <%= link_to "Contributions", admin_contributions_path, class: ts(:button, :secondary) %>
  <%= link_to "Loans", admin_loans_path, class: ts(:button, :secondary) %>
</div>
