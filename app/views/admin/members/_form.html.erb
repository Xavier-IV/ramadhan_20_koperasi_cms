<%= form_with model: [:admin, member], class: ts(:form, :group) do |f| %>
  <% if member.errors.any? %>
    <div class="<%= ts(:alert, :wrapper) %> <%= ts(:alert, :error) %>">
      <div>
        <p class="<%= ts(:alert, :title) %>"><%= pluralize(member.errors.count, "error") %> prevented saving:</p>
        <ul class="<%= ts(:alert, :message) %> list-disc pl-4 mt-1">
          <% member.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="<%= ts(:form, :field) %>">
    <%= f.label :name, class: ts(:form, :label) %>
    <%= f.text_field :name, class: ts(:input, :base), placeholder: "Full name" %>
  </div>

  <div class="<%= ts(:form, :field) %>">
    <%= f.label :ic_number, "IC Number", class: ts(:form, :label) %>
    <%= f.text_field :ic_number, class: ts(:input, :base), placeholder: "e.g. 800101-14-5001" %>
  </div>

  <div class="<%= ts(:form, :field) %>">
    <%= f.label :phone, class: ts(:form, :label) %>
    <%= f.text_field :phone, class: ts(:input, :base), placeholder: "e.g. 011-2345678" %>
  </div>

  <div class="<%= ts(:form, :field) %>">
    <%= f.label :address, class: ts(:form, :label) %>
    <%= f.text_area :address, class: ts(:input, :base), rows: 3, placeholder: "Full address" %>
  </div>

  <div class="flex items-center gap-6">
    <div class="<%= ts(:form, :field) %> flex-1">
      <%= f.label :join_date, "Join Date", class: ts(:form, :label) %>
      <%= f.date_field :join_date, class: ts(:input, :base) %>
    </div>
    <div class="<%= ts(:form, :field) %> flex-1">
      <%= f.label :status, class: ts(:form, :label) %>
      <%= f.select :status, Member.statuses.keys.map { |s| [s.titleize, s] }, {}, class: ts(:select, :base) %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit member.persisted? ? "Update" : "Create", class: ts(:button, :primary) %>
    <%= link_to "Cancel", admin_members_path, class: ts(:button, :ghost) %>
  </div>
<% end %>
