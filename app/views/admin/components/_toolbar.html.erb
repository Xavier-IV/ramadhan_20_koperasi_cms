<%# locals: (search_name: "query", search_placeholder: "Search...", search_value: nil) %>
<div class="<%= ts(:toolbar, :wrapper) %>">
  <div class="<%= ts(:toolbar, :search_wrapper) %>">
    <svg class="<%= ts(:toolbar, :search_icon) %> w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
    </svg>
    <input type="text" name="<%= search_name %>" value="<%= search_value %>" placeholder="<%= search_placeholder %>" class="<%= ts(:toolbar, :search_input) %>" />
  </div>
  <% if block_given? %>
    <div class="<%= ts(:toolbar, :actions) %>">
      <%= yield %>
    </div>
  <% end %>
</div>
