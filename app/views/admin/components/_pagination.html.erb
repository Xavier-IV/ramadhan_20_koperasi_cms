<%# locals: (current_page:, total_pages:, path_proc: nil, info: nil) %>
<nav class="<%= ts(:pagination, :wrapper) %>">
  <% if info %>
    <span class="<%= ts(:pagination, :info) %>"><%= info %></span>
  <% end %>
  <div class="flex items-center gap-0.5">
    <%# Previous %>
    <% if current_page > 1 %>
      <a href="<%= path_proc ? path_proc.call(current_page - 1) : '#' %>" class="<%= ts(:pagination, :item) %>">&laquo; Prev</a>
    <% else %>
      <span class="<%= ts(:pagination, :item_disabled) %>">&laquo; Prev</span>
    <% end %>

    <%# Page numbers %>
    <% (1..total_pages).each do |page| %>
      <% if page == current_page %>
        <span class="<%= ts(:pagination, :item_active) %>"><%= page %></span>
      <% elsif (page - current_page).abs <= 2 || page == 1 || page == total_pages %>
        <a href="<%= path_proc ? path_proc.call(page) : '#' %>" class="<%= ts(:pagination, :item) %>"><%= page %></a>
      <% elsif (page - current_page).abs == 3 %>
        <span class="<%= ts(:pagination, :ellipsis) %>">&hellip;</span>
      <% end %>
    <% end %>

    <%# Next %>
    <% if current_page < total_pages %>
      <a href="<%= path_proc ? path_proc.call(current_page + 1) : '#' %>" class="<%= ts(:pagination, :item) %>">Next &raquo;</a>
    <% else %>
      <span class="<%= ts(:pagination, :item_disabled) %>">Next &raquo;</span>
    <% end %>
  </div>
</nav>
